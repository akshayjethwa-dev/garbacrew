{
  "expo": {
    "name": "GarbaCrew",
    "slug": "garbacrew",
    "scheme": "garbacrew",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "GarbaCrew needs camera access for selfie verification."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GarbaCrew needs access to your photos to set a profile picture."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GarbaCrew uses your location to find Plans near you."
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.garbacrew.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.garbacrew.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}