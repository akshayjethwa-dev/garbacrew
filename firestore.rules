rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ─────────────────────────────────────────────────────────
    // Users (Epic 1 + 2 + 5 + 6)
    // ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(['hostScore', 'guestScore', 'trustBalance', 'isBanned', 'suspendedUntil', 'strikes']);

      match /emergencyContacts/{contactId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // ─────────────────────────────────────────────────────────
    // Plans (Epic 3)
    // ─────────────────────────────────────────────────────────
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && getTrust(request.auth.uid) >= 30;
      allow update: if request.auth != null
        && (resource.data.hostUid == request.auth.uid
            || resource.data.participants.hasAny([request.auth.uid]));
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Squads (Epic 4)
    // ─────────────────────────────────────────────────────────
    match /squads/{squadId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.adminUid == request.auth.uid
        && getTrust(request.auth.uid) >= 30;
      allow update: if request.auth != null
        && (resource.data.adminUid == request.auth.uid
            || resource.data.coAdminUids.hasAny([request.auth.uid])
            || (resource.data.memberUids.hasAny([request.auth.uid])
                && request.resource.data.memberUids.hasAny([request.auth.uid])));
      allow delete: if false;

      match /memberLogs/{logId} {
        allow read: if request.auth != null
          && resource.data.targetUid == request.auth.uid;
        allow write: if false;
      }
    }

    // ─────────────────────────────────────────────────────────
    // Invitations (Epic 5)
    // ─────────────────────────────────────────────────────────
    match /invitations/{invitationId} {
      allow create: if request.auth != null
        && request.resource.data.inviterUid == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.invitedUid == request.auth.uid
            || resource.data.inviterUid == request.auth.uid);
      allow update: if request.auth != null
        && resource.data.invitedUid == request.auth.uid
        && request.resource.data.status in ["accepted", "declined"];
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Partner Swipes (Epic 6)
    // ─────────────────────────────────────────────────────────
    match /partnerSwipes/{swipeId} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Partner Matches (Epic 6)
    // ─────────────────────────────────────────────────────────
    match /partnerMatches/{matchId} {
      allow read: if request.auth != null
        && resource.data.users.hasAny([request.auth.uid]);
      allow create: if request.auth != null
        && request.resource.data.users.hasAny([request.auth.uid]);
      allow update: if request.auth != null
        && resource.data.users.hasAny([request.auth.uid]);

      match /messages/{messageId} {
        allow read: if request.auth != null
          && get(/databases/$(db)/documents/partnerMatches/$(matchId)).data.users.hasAny([request.auth.uid]);
        allow create: if request.auth != null
          && request.resource.data.fromUid == request.auth.uid
          && get(/databases/$(db)/documents/partnerMatches/$(matchId)).data.users.hasAny([request.auth.uid]);
        allow update, delete: if false;
      }
    }

    // ─────────────────────────────────────────────────────────
    // SOS Events (Epic 7)
    // ─────────────────────────────────────────────────────────
    match /sosEvents/{sosId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || request.resource.data.respondedBy.hasAny([request.auth.uid]));
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Live Locations (Epic 7)
    // ─────────────────────────────────────────────────────────
    match /liveLocations/{locId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────
    // Blocks (Epic 7)
    // ─────────────────────────────────────────────────────────
    match /blocks/{blockId} {
      allow read: if request.auth != null
        && (resource.data.blockerUid == request.auth.uid
            || resource.data.blockedUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.blockerUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Reports (Epic 7)
    // ─────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid;
      allow read: if request.auth != null
        && resource.data.reporterUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Disputes (Epic 7)
    // ─────────────────────────────────────────────────────────
    match /disputes/{disputeId} {
      allow create: if request.auth != null
        && request.resource.data.filedByUid == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.filedByUid == request.auth.uid
            || resource.data.againstUid == request.auth.uid);
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Strikes (Epic 7)
    // ─────────────────────────────────────────────────────────
    match /strikes/{strikeId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Safety Alerts (Epic 7)
    // ─────────────────────────────────────────────────────────
    match /safetyAlerts/{alertId} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Payouts (Epic 8)
    // ─────────────────────────────────────────────────────────
    match /payouts/{payoutId} {
      allow read: if request.auth != null
        && resource.data.hostUid == request.auth.uid;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Subscriptions (Epic 8)
    // ─────────────────────────────────────────────────────────
    match /subscriptions/{uid} {
      allow read: if request.auth != null
        && request.auth.uid == uid;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Boosts (Epic 8)
    // ─────────────────────────────────────────────────────────
    match /boosts/{boostId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Pending Boost Orders (Epic 8)
    // ─────────────────────────────────────────────────────────
    match /pendingBoostOrders/{orderId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Vendors (Epic 8)
    // ─────────────────────────────────────────────────────────
    match /vendors/{vendorId} {
      allow read: if request.auth != null
        && (resource.data.status == "approved"
            || resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Partnerships (Epic 8)
    // ─────────────────────────────────────────────────────────
    match /partnerships/{partnershipId} {
      allow read: if request.auth != null
        && resource.data.status == "active";
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Admin alerts (Epic 8)
    // ─────────────────────────────────────────────────────────
    match /adminAlerts/{alertId} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Partnership invoices (Epic 8)
    // ─────────────────────────────────────────────────────────
    match /partnershipInvoices/{invoiceId} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Chats (Epic 3 + 4)
    // ─────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(db)/documents/chats/$(chatId)).data.participants;
      }
    }

    // ─────────────────────────────────────────────────────────
    // Score Events (Epic 2)
    // ─────────────────────────────────────────────────────────
    match /scoreEvents/{eventId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || resource.data.participantUids.hasAny([request.auth.uid])
            || resource.data.hostUid == request.auth.uid);
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Escrow (Epic 2)
    // ─────────────────────────────────────────────────────────
    match /escrow/{escrowId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Ratings (Epic 2 + 3)
    // ─────────────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────
    // Activity Feed (Epic 3)
    // ─────────────────────────────────────────────────────────
    match /activityFeed/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }

  // ─────────────────────────────────────────────────────────
  // Helper functions
  // ─────────────────────────────────────────────────────────
  function getTrust(uid) {
    return get(/databases/$(db)/documents/users/$(uid)).data.trustBalance;
  }
}