rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users ───
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(['hostScore', 'guestScore', 'trustBalance']);
    }

    // ─── Plans ───
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && getTrust(request.auth.uid) >= 30;
      allow update: if request.auth != null
        && (resource.data.hostUid == request.auth.uid
            || resource.data.participants.hasAny([request.auth.uid]));
      allow delete: if false;
    }

    // ─── Chats (plan chats) ───
    match /chats/{chatId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null;
      allow update: if request.auth != null;

      match /messages/{messageId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // ─── Score Events ───
    match /scoreEvents/{eventId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || resource.data.participantUids.hasAny([request.auth.uid])
            || resource.data.hostUid == request.auth.uid);
      allow write: if false;
    }

    // ─── Escrow ───
    match /escrow/{escrowId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ─── Ratings ───
    match /ratings/{ratingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── Activity Feed ───
    match /activityFeed/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }

  function getTrust(uid) {
    return get(/databases/$(database)/documents/users/$(uid)).data.trustBalance;
  }
}