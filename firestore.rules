rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Users ───
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(['hostScore', 'guestScore', 'trustBalance', 'isBanned', 'suspendedUntil', 'strikes']);

      match /emergencyContacts/{contactId} {
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }

    // ─── Plans ───
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && getTrust(request.auth.uid) >= 30;
      allow update: if request.auth != null
        && (resource.data.hostUid == request.auth.uid
            || resource.data.participants.hasAny([request.auth.uid]));
      allow delete: if false;
    }

    // ─── Squads ───
    match /squads/{squadId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.adminUid == request.auth.uid
        && getTrust(request.auth.uid) >= 30;
      allow update: if request.auth != null
        && (resource.data.adminUid == request.auth.uid
            || resource.data.coAdminUids.hasAny([request.auth.uid])
            || (resource.data.memberUids.hasAny([request.auth.uid])
                && request.resource.data.memberUids.hasAny([request.auth.uid])));
      allow delete: if false;

      match /memberLogs/{logId} {
        allow read: if request.auth != null
          && resource.data.targetUid == request.auth.uid;
        allow write: if false;
      }
    }

    // ─── Invitations ───
    match /invitations/{invitationId} {
      allow create: if request.auth != null
        && request.resource.data.inviterUid == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.invitedUid == request.auth.uid
            || resource.data.inviterUid == request.auth.uid);
      allow update: if request.auth != null
        && resource.data.invitedUid == request.auth.uid
        && request.resource.data.status in ["accepted", "declined"];
      allow delete: if false;
    }

    // ─── Partner Swipes ───
    match /partnerSwipes/{swipeId} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── Partner Matches ───
    match /partnerMatches/{matchId} {
      allow read: if request.auth != null
        && resource.data.users.hasAny([request.auth.uid]);
      allow create: if request.auth != null
        && request.resource.data.users.hasAny([request.auth.uid]);
      allow update: if request.auth != null
        && resource.data.users.hasAny([request.auth.uid]);

      match /messages/{messageId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/partnerMatches/$(matchId)).data.users.hasAny([request.auth.uid]);
        allow create: if request.auth != null
          && request.resource.data.fromUid == request.auth.uid
          && get(/databases/$(database)/documents/partnerMatches/$(matchId)).data.users.hasAny([request.auth.uid]);
        allow update, delete: if false;
      }
    }

    // ─── SOS Events (Epic 7) ───
    match /sosEvents/{sosId} {
      // Anyone authenticated in the same chat/plan can read
      allow read: if request.auth != null;
      // Anyone can create their own SOS
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      // Only the sender can update (cancel) their own SOS, or acknowledgedBy
      allow update: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || request.resource.data.respondedBy.hasAny([request.auth.uid]));
      allow delete: if false;
    }

    // ─── Live Locations (Epic 7) ───
    match /liveLocations/{locId} {
      // Read: anyone authenticated (the app filters by scope)
      allow read: if request.auth != null;
      // Write: only the owner
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      // Delete: only the owner
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // ─── Blocks (Epic 7) ───
    match /blocks/{blockId} {
      allow read: if request.auth != null
        && (resource.data.blockerUid == request.auth.uid
            || resource.data.blockedUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.blockerUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    // ─── Reports (Epic 7) ───
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid;
      allow read: if request.auth != null
        && resource.data.reporterUid == request.auth.uid;
      allow update, delete: if false; // only Cloud Functions
    }

    // ─── Disputes (Epic 7) ───
    match /disputes/{disputeId} {
      allow create: if request.auth != null
        && request.resource.data.filedByUid == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.filedByUid == request.auth.uid
            || resource.data.againstUid == request.auth.uid);
      allow update, delete: if false;
    }

    // ─── Strikes (Epic 7) — read-only for target ───
    match /strikes/{strikeId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ─── Safety Alerts (Epic 7) — admin only ───
    match /safetyAlerts/{alertId} {
      allow read, write: if false; // admin SDK only
    }

    // ─── Chats ───
    match /chats/{chatId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // ─── Score Events ───
    match /scoreEvents/{eventId} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || resource.data.participantUids.hasAny([request.auth.uid])
            || resource.data.hostUid == request.auth.uid);
      allow write: if false;
    }

    // ─── Escrow ───
    match /escrow/{escrowId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ─── Ratings ───
    match /ratings/{ratingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── Activity Feed ───
    match /activityFeed/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }

  function getTrust(uid) {
    return get(/databases/$(database)/documents/users/$(uid)).data.trustBalance;
  }
}